[sub_resource type="GDScript" id="GDScript_texq8"]
resource_name = "gracz.gd"
script/source = "extends CharacterBody2D

enum Stany { IDLE, RUN, JUMP, FALL, DEAD, SLIDE }
var aktualny_stan = Stany.IDLE

@export var SPEED = 120.0
@export var JUMP_VELOCITY = -340.0

var scena_pocisku = preload(\"res://sceny/pocisk_gracza.tscn\")

@onready var lufa = $Lufa
@onready var animacja = $AnimatedSprite2D

func _physics_process(delta: float) -> void:
	if aktualny_stan == Stany.DEAD:
		if not is_on_floor():
			velocity += get_gravity() * delta
		else:
			velocity.x = 0
		move_and_slide()
		return

	# STRZAŁ
	if Input.is_action_just_pressed(\"strzal\"):
		strzel()

	# GRAWITACJA
	if not is_on_floor():
		velocity += get_gravity() * delta

	# SKOK / ŚLIZG
	if is_on_floor():
		if Input.is_action_just_pressed(\"skok\"):
			velocity.y = JUMP_VELOCITY
		elif Input.is_action_just_pressed(\"slizg\"):
			wykonaj_slizg()

	# RUCH
	if aktualny_stan != Stany.SLIDE:
		var direction := Input.get_axis(\"ui_left\", \"ui_right\")
		if direction:
			velocity.x = direction * SPEED
			animacja.flip_h = direction < 0
		else:
			velocity.x = move_toward(velocity.x, 0, SPEED)

	# LUFA LEWO/PRAWO
	if animacja.flip_h:
		lufa.position.x = -abs(lufa.position.x)
	else:
		lufa.position.x = abs(lufa.position.x)

	_aktualizuj_stan()
	_odtworz_animacje()
	move_and_slide()

func strzel():
	var p = scena_pocisku.instantiate()
	
	# 1. NAJPIERW USTAW ZMIENNĄ KIERUNKU
	p.kierunek_ruchu = -1.0 if animacja.flip_h else 1.0
	
	# 2. DOPIERO POTEM DODAJ DO SCENY (To uruchomi _ready w pocisku)
	get_parent().add_child(p)
	
	# 3. Na koniec ustaw pozycję
	p.global_position = lufa.global_position

func _aktualizuj_stan():
	if aktualny_stan == Stany.DEAD or aktualny_stan == Stany.SLIDE:
		return

	if not is_on_floor():
		if velocity.y < 0:
			aktualny_stan = Stany.JUMP
		else:
			aktualny_stan = Stany.FALL
	else:
		if velocity.x != 0:
			aktualny_stan = Stany.RUN
		else:
			aktualny_stan = Stany.IDLE

func _odtworz_animacje():
	match aktualny_stan:
		Stany.IDLE:
			animacja.play(\"idle\")
		Stany.RUN:
			animacja.play(\"run\")
		Stany.JUMP:
			if animacja.sprite_frames.has_animation(\"jump\"):
				animacja.play(\"jump\")
		Stany.FALL:
			if animacja.sprite_frames.has_animation(\"fall\"):
				animacja.play(\"fall\")
		Stany.DEAD:
			animacja.play(\"death\")
		Stany.SLIDE:
			animacja.play(\"slide\")

func wykonaj_slizg():
	aktualny_stan = Stany.SLIDE
	velocity.x = 250 if not animacja.flip_h else -250
	_odtworz_animacje()
	
	await get_tree().create_timer(0.5).timeout
	aktualny_stan = Stany.IDLE

func ginie():
	if aktualny_stan == Stany.DEAD:
		return

	aktualny_stan = Stany.DEAD
	velocity.y = -150
	_odtworz_animacje()
	
	print(\"Gracz poległ!\")
	get_tree().call_group(\"Wrogowie\", \"reset_celu\")
	
	await get_tree().create_timer(1.5).timeout
"

