[sub_resource type="Shader" id="Shader_qytfp"]
code = "shader_type canvas_item;

uniform float predkosc : hint_range(0.0, 10.0) = 2.5;
uniform float sila_bujania : hint_range(0.0, 50.0) = 10.0;

void vertex() {

    vec2 world_pos = (MODEL_MATRIX * vec4(VERTEX, 0.0, 1.0)).xy;

    float oscylacja = sin(
    TIME * predkosc * 4.0 +
    world_pos.x * 0.1
);

    // dół = 0 ruchu
    // góra = pełny ruch
    float maska = smoothstep(0.0, 0.7, UV.y);

    VERTEX.x += oscylacja * sila_bujania * maska;
}"

