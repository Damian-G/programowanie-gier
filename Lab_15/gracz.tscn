[sub_resource type="GDScript" id="GDScript_texq8"]
resource_name = "gracz.gd"
script/source = "extends CharacterBody2D

enum Stany { IDLE, RUN, JUMP, FALL }
var aktualny_stan = Stany.IDLE

@export var SPEED = 120.0
@export var JUMP_VELOCITY = -400.0
@onready var animacja = $AnimatedSprite2D

func _physics_process(delta: float) -> void:
	
	if not is_on_floor():
		velocity += get_gravity() * delta

	if Input.is_action_just_pressed(\"ui_accept\") and is_on_floor():
		velocity.y = JUMP_VELOCITY

	var direction := Input.get_axis(\"ui_left\", \"ui_right\")
	
	if direction:
		velocity.x = direction * SPEED
		animacja.flip_h = direction < 0
	else:
		velocity.x = move_toward(velocity.x, 0, SPEED)
	
	_aktualizuj_stan(direction)
	_odtworz_animacje()

	move_and_slide()

func _aktualizuj_stan(direction: float):
	if not is_on_floor():
		if velocity.y < 0:
			aktualny_stan = Stany.JUMP
		else:
			aktualny_stan = Stany.FALL
	else:
		if direction != 0:
			aktualny_stan = Stany.RUN
		else:
			aktualny_stan = Stany.IDLE

func _odtworz_animacje():
	match aktualny_stan:
		Stany.IDLE:
			animacja.play(\"idle\")
		Stany.RUN:
			animacja.play(\"run\")
		Stany.JUMP:
			if animacja.sprite_frames.has_animation(\"jump\"):
				animacja.play(\"jump\")
		Stany.FALL:
			if animacja.sprite_frames.has_animation(\"fall\"):
				animacja.play(\"fall\")
"

